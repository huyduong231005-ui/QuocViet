# Local demo: no Docker, PostgreSQL server or model key required.
HOST=127.0.0.1
PORT=3000
DEMO_MODE=true
AGENT_ENABLED=false
AGENT_EXTRACTION_ENABLED=false
# DATA_DIR=D:/Quoc_VIet/.data/postgres
# DATABASE_URL=postgresql://procureiq:replace_me@127.0.0.1:5432/procureiq
# WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# A fresh non-demo database requires all three values below.
# DEMO_MODE=false
# JWT_SECRET=replace_with_random_secret_at_least_32_characters
# ADMIN_EMAIL=admin@your-company.example
# ADMIN_PASSWORD=replace_with_private_password

# Phase 1: set AGENT_EXTRACTION_ENABLED=true to read quotation drafts.
# Full workflow uses AGENT_ENABLED; enable it only when that stage is ready.
# AGENT_URL=http://127.0.0.1:8001
# AGENT_API_KEY=replace_with_private_agent_key
# LLM_API_KEY=configure_locally_with_scripts/configure-ai.ps1
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4.1-mini
# For Gemini, use scripts/configure-gemini.ps1 and enter one or more keys locally.
# LLM_PROVIDER=gemini
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_API_KEYS=configure_locally_with_scripts/configure-gemini.ps1
# BACKEND_URL=http://127.0.0.1:3000/api
# AGENT_DATABASE_URL=separate_checkpoint_database_for_full_workflow

# Real RFQ/PO mail. Off until SMTP_USER and SMTP_PASSWORD are both set.
# For Gmail the password is a 16-character App Password, not the login password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM_NAME=ProcureIQ
# MAIL_REDIRECT_TO=sender   (sender: mail goes to the logged-in user who sent it; an address: to that address; empty: to the supplier)
