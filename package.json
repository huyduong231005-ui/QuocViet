{
  "name": "procureiq-ahp-agent",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/api && npm run build --workspace apps/web",
    "test": "npm run test --workspace apps/api && npm run test --workspace apps/web",
    "start": "npm run start --workspace apps/api",
    "test:native": "node scripts/with-test-cluster.cjs --test test/database-native.test.ts",
    "db": "npm run db --workspace apps/api --"
  },
  "engines": {
    "node": ">=22"
  }
}
